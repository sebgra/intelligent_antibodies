{"nodes": [{"id": "readme_intelligent_antibodies", "label": "Intelligent Antibodies project", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Antibody design is slow, expensive and relies on in-vitro screening plus hard-to-compute binding-energy estimates; the project explores an in-silico alternative that turns candidate discovery into rejection sampling in a learned latent space instead of a physics-based energy calculation."}, {"id": "readme_convolutional_vae_generator", "label": "Convolutional VAE generator (2-D latent space)", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Trained on antibody sequences only, one-hot encoded, Conv2D encoder / Conv2DTranspose decoder with a 2-D latent space so the sampled space stays directly plottable and explorable; sampling z = temperature x N(0,1) makes temperature an explicit knob trading sampling diversity against decode fidelity."}, {"id": "readme_siamese_interaction_classifier", "label": "Siamese CNN+GRU interaction classifier", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A shared Conv1D + bidirectional-GRU tower embeds both candidate antibody and target antigen so one learned representation serves both inputs; embeddings are combined and passed through a sigmoid to give an interaction probability usable as a cheap stand-in for binding-energy computation."}, {"id": "readme_rejection_sampling", "label": "Rejection sampling of candidates", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Candidates are sampled in batches and kept only if the predicted interaction score clears a threshold; the same loop is shared by the dashboard and the CLI so generation behaviour cannot diverge between the two entry points."}, {"id": "readme_dataset_balancing", "label": "Negative-class downsampling (dataset balancing)", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Real antibody-antigen pairs are overwhelmingly non-interacting, so the negative class is downsampled to match the positive one before fitting the classifier, otherwise the classifier would trivially predict 'no interaction'."}, {"id": "readme_esmfold_structure_prediction", "label": "ESMFold structure prediction", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ESMFold via the free public ESM Atlas API is used as a practical, GPU-cluster-free stand-in for AlphaFold2; it needs internet and can take about a minute, which is why folding is on demand behind a button rather than automatic. Structures are coloured by per-residue pLDDT using AlphaFold's own colour convention for familiarity."}, {"id": "readme_schematic_secondary_structure_cartoon", "label": "Schematic secondary-structure cartoon", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A simplified secondary-structure heuristic gives every candidate an instant, offline, clearly-labelled illustrative cartoon, so the expensive real fold stays optional."}, {"id": "readme_streamlit_dashboard", "label": "Streamlit dashboard (Generate / Results / Dataset & Model)", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_simulated_mode", "label": "Simulated-results fallback mode", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No pretrained weights are shipped, so the dashboard detects whether real models exist under run/models/ and otherwise shows clearly-labelled simulated results; this lets the interface be explored in under a minute with no data download or training, and the switch to real output needs no flag."}, {"id": "readme_latent_space_exploration", "label": "Interactive 2-D latent-space exploration with box/lasso selection", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Box or lasso selection over sampled latent points filters every other tab to that selection, making clusters of the latent space the unit of analysis."}, {"id": "readme_per_length_weight_storage", "label": "Per-sequence-length model weights (vector_size encoding window)", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Weights are stored per sequence length (200 aa default), so the dashboard loads the models trained for the chosen length and, when none exist, reports which lengths are trained and falls back to simulated results."}, {"id": "readme_one_hot_encoding", "label": "One-hot sequence encoding", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One-hot is the encoding both shipped models use; k-mer / Prot-Vec style encoders and Chaos Game Representation were explored during prototyping but not adopted."}, {"id": "readme_kmer_protvec_encoding", "label": "k-mer / Prot-Vec style sequence encoding", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_chaos_game_representation", "label": "Chaos Game Representation encoding", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_data_pipeline", "label": "SAbDab data pipeline (four ordered scripts)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each script resolves its own paths relative to the repo root so it works from anywhere, and downloads skip ids already present so the fetch stage is resumable."}, {"id": "readme_sabdab_dataset", "label": "SAbDab antibody-antigen dataset", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "X-ray-crystallography immune complexes across many species; the dataset the current pipeline actually trains on."}, {"id": "readme_cov_abdab_dataset", "label": "CoV-AbDab SARS-CoV antibody/antigen dataset", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Included for future work; not yet wired into the training scripts."}, {"id": "readme_reciprocal_unordered_pair_relation", "label": "Reciprocal, unordered positive-pair relation", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Either partner of a positive pair can be the antibody or the antigen side, so the filter step checks both orderings; any pair not listed is treated as a negative sample."}, {"id": "readme_approximate_custom_metrics", "label": "Approximate custom Siamese metrics (accuracy / f1 / mcc)", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Simple, approximate formulas kept for continuity with earlier experiments rather than calibrated production-grade metrics - a known limitation of the research status of the project."}, {"id": "readme_web_interface_prototype", "label": "Earlier Flask + Vue.js web prototype (superseded)", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Superseded by the Streamlit app under app/ but kept in the repo for reference."}, {"id": "readme_uv_environment_management", "label": "uv-managed Python 3.12 environment", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_dl_antibody_antigen_binding_benchmark_article", "label": "Deep learning benchmark for antibody-antigen binding (motivating article)", "file_type": "paper", "source_file": "README.md", "source_location": null, "source_url": "https://www.sciencedirect.com/science/article/pii/S1093326322002431", "captured_at": null, "author": null, "contributor": null}, {"id": "readme_abagintpre", "label": "AbAgIntPre - Siamese antibody-antigen interaction predictor", "file_type": "paper", "source_file": "README.md", "source_location": null, "source_url": "https://www.frontiersin.org/journals/immunology/articles/10.3389/fimmu.2022.1053617/full", "captured_at": null, "author": null, "contributor": null}, {"id": "readme_piercelab_antibody_benchmark", "label": "piercelab/antibody_benchmark docking benchmark", "file_type": "paper", "source_file": "README.md", "source_location": null, "source_url": "https://github.com/piercelab/antibody_benchmark", "captured_at": null, "author": null, "contribut